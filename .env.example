# Tech Quiz Entrance — environment variables
# Copy to .env.local for `vercel dev` (Vercel CLI loads .env.local automatically).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Turso (libSQL) database. Create with:
#   turso db create tech-quiz
#   turso db show tech-quiz --url
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
#   turso db tokens create tech-quiz
TURSO_AUTH_TOKEN=your-turso-token

# Random 32+ byte string used to sign session cookies (jose HS256).
# Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Seed admin account (used by `npm run db:seed` / `bun run db:seed`; only the
# bcrypt hash is stored in the database — remove these from prod after seeding).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vercel Blob — enable Blob in the Vercel dashboard for the project
# (Storage → Create Blob store) and it provides this token.
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/* endpoints. Vercel Cron sends it automatically as
# `Authorization: Bearer <CRON_SECRET>` when this env var exists.
CRON_SECRET=change-me
